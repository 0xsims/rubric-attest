{
  "name": "@rubric/evidence",
  "version": "1.0.0",
  "type": "module",
  "description": "Rubric evidence export CLI: offline evidence bundles from index shards + bundle store",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xsims/rubric-attest.git",
    "directory": "packages/evidence"
  },
