  },
  "files": ["dist", "src"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rubric/attest-decision": "^1.0.0",
    "better-sqlite3": "^11.3.0"
  }
